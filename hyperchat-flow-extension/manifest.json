{
  "manifest_version": 3,
  "name": "HyperChat Flow",
  "version": "1.0.0",
  "description": "HyperChatと互換性のある、YouTubeライブのコメントを動画上に流す拡張機能",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch?*", "https://www.youtube.com/live/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
