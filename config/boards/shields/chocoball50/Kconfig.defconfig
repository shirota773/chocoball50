if SHIELD_CHOCOBALL50

config ZMK_KEYBOARD_NAME
    default "Chocoball50"

config ZMK_USB_LOGGING
    default n

# SPI for LED strip
config SPI
    default y

# LED strip configuration
config LED_STRIP
    default y

config ZMK_RGB_UNDERGLOW
    default y

config ZMK_RGB_UNDERGLOW_EXT_POWER
    default y

config ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
    default y

# Encoder configuration
# Re-enabled with duplex matrix
config EC11
    default y

# Trackball (az1uball) configuration
config I2C
    default y

config INPUT
    default y

config ZMK_MOUSE
    default y

# az1uball driver configuration (integrated)
if I2C && INPUT

config AZ1UBALL
    bool "az1uball trackball driver"
    default y
    help
      Enable driver for az1uball trackball module.
      The az1uball uses hall effect sensors and communicates
      via I2C at address 0x0A.

config AZ1UBALL_THREAD_PRIORITY
    int "az1uball thread priority"
    default 50
    depends on AZ1UBALL
    help
      Priority of thread used to handle the trackball data.

config AZ1UBALL_POLL_INTERVAL_MS
    int "az1uball polling interval in milliseconds"
    default 8
    depends on AZ1UBALL
    help
      Interval between polling the az1uball for movement data.

endif

endif
