if SHIELD_CHOCOBALL50

config ZMK_KEYBOARD_NAME
    default "Chocoball50"

config ZMK_USB_LOGGING
    default n

# Japanese duplex matrix kscan driver
config ZMK_KSCAN_GPIO_DUPLEX
    bool "Japanese duplex matrix keyboard scan driver"
    default y
    depends on GPIO
    help
      Enable support for Japanese duplex matrix scanning.

      This driver allows bidirectional scanning of a keyboard matrix,
      where the same GPIO pins alternate between column (output) and
      row (input) roles in two separate scanning passes.

      This significantly reduces the number of GPIO pins needed:
      - Standard 4x13 matrix: 17 pins
      - Duplex 7+4 matrix: 11 pins (52+ keys capacity)

      Requires proper diode placement for bidirectional scanning.

if ZMK_KSCAN_GPIO_DUPLEX

config KSCAN
    default y

endif # ZMK_KSCAN_GPIO_DUPLEX

# SPI for LED strip
config SPI
    default y

# LED strip configuration
config LED_STRIP
    default y

config ZMK_RGB_UNDERGLOW
    default y

config ZMK_RGB_UNDERGLOW_EXT_POWER
    default y

config ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
    default y

# Encoder configuration
# Re-enabled with duplex matrix
config EC11
    default y

# Trackball (az1uball) configuration
config I2C
    default y

config INPUT
    default y

config ZMK_MOUSE
    default y

# az1uball driver configuration (integrated)
if I2C && INPUT

config AZ1UBALL
    bool "az1uball trackball driver"
    default y
    help
      Enable driver for az1uball trackball module.
      The az1uball uses hall effect sensors and communicates
      via I2C at address 0x0A.

config AZ1UBALL_THREAD_PRIORITY
    int "az1uball thread priority"
    default 50
    depends on AZ1UBALL
    help
      Priority of thread used to handle the trackball data.

config AZ1UBALL_POLL_INTERVAL_MS
    int "az1uball polling interval in milliseconds"
    default 8
    depends on AZ1UBALL
    help
      Interval between polling the az1uball for movement data.

endif

endif
