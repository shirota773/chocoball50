#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
        zmk,ext-power = &ext_power_ctrl;
    };

    /* External power control for RGB LEDs
     * NOTE: This uses P1.13. Adjust based on your hardware.
     */
    ext_power_ctrl: ext_power_ctrl {
        compatible = "zmk,ext-power-generic";
        label = "EXT_POWER";
        control-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };

    /* 4x13 Ortholinear Matrix Transform */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12)
        >;
    };

    /* Japanese Duplex Matrix - Bidirectional GPIO scanning
     * 11 pins total (saves 6 pins vs. standard 4x13 matrix)
     *
     * Configuration:
     * - duplex-gpios = 7: First 7 pins are columns in pass 1, rows in pass 2
     *                     Last 4 pins are rows in pass 1, columns in pass 2
     *
     * Pass 1 (COL2ROW): 7 columns × 4 rows = 28 keys
     * Pass 2 (ROW2COL): 7 rows × 4 columns = 28 keys
     * Total capacity: 56 keys (52 keys used)
     *
     * Pin usage: D1, D0, D2, D3, D4, D5, D6, D7, D8, D9, D10
     * Freed pins: D14-D16, A0-A2 (can be used for encoder, I2C, etc.)
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-duplex";
        status = "okay";

        /* All 11 GPIO pins for duplex scanning */
        gpios
            = <&pro_micro 1 GPIO_ACTIVE_HIGH>  /* Pin 0: Col in pass1, Row in pass2 */
            , <&pro_micro 0 GPIO_ACTIVE_HIGH>  /* Pin 1: Col in pass1, Row in pass2 */
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>  /* Pin 2: Col in pass1, Row in pass2 */
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>  /* Pin 3: Col in pass1, Row in pass2 */
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>  /* Pin 4: Col in pass1, Row in pass2 */
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>  /* Pin 5: Col in pass1, Row in pass2 */
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>  /* Pin 6: Col in pass1, Row in pass2 */
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>  /* Pin 7: Row in pass1, Col in pass2 */
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>  /* Pin 8: Row in pass1, Col in pass2 */
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>  /* Pin 9: Row in pass1, Col in pass2 */
            , <&pro_micro 10 GPIO_ACTIVE_HIGH> /* Pin 10: Row in pass1, Col in pass2 */
            ;

        /* Split point: first 7 pins = columns in pass1, last 4 pins = rows in pass1 */
        duplex-gpios = <7>;

        /* Debounce configuration */
        debounce-period-ms = <5>;
        poll-period-ms = <10>;
    };

    /* Horizontal Rotary Encoder
     * Re-enabled with duplex matrix (freed P1.01/P1.02)
     */
    encoder: encoder {
        compatible = "alps,ec11";
        label = "ENCODER";
        a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <15>;
    };
};

/* I2C1 configuration for trackball
 * Uses A0/P0.04 (SDA) and A1/P0.05 (SCL) - freed by duplex matrix.
 * I2C pins configured in boards/nice_nano.overlay.
 * Encoder uses P1.01/P1.02 (extra GPIO on back of nice!nano).
 */
&i2c1 {
    trackball: trackball@a {
        compatible = "palette,az1uball";
        reg = <0x0a>;
        label = "TRACKBALL";
        invert-x;
        /* Uncomment to adjust trackball behavior:
         * invert-y;
         * swap-xy;
         */
    };
};
