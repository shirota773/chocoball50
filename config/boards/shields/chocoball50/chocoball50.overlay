#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
        zmk,ext-power = &ext_power_ctrl;
    };

    /* External power control for RGB LEDs
     * NOTE: This uses P1.13. Adjust based on your hardware.
     */
    ext_power_ctrl: ext_power_ctrl {
        compatible = "zmk,ext-power-generic";
        label = "EXT_POWER";
        control-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };

    /* Duplex Matrix Transform - 11 rows × 7 columns */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <11>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(5,0) RC(5,1)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(5,2) RC(5,3) RC(6,0) RC(6,1) RC(6,2) RC(6,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(8,0) RC(8,1)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(8,2) RC(8,3) RC(9,0) RC(9,1) RC(9,2) RC(9,3)
        >;
    };

    /* Japanese Duplex Matrix */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-duplex";
        status = "okay";

        gpios
            = <&pro_micro 1 GPIO_ACTIVE_HIGH>
            , <&pro_micro 0 GPIO_ACTIVE_HIGH>
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>
            ;

        duplex-split-index = <7>;
        debounce-period-ms = <5>;
        poll-period-ms = <10>;
    };

    /* Horizontal Rotary Encoder
     * Temporarily disabled - P1.01/P1.02 are used for trackball I2C
     */
    /*
    encoder: encoder {
        compatible = "alps,ec11";
        label = "ENCODER";
        a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <15>;
    };
    */
};

/* I2C1 configuration for trackball
 * Uses A0/P0.04 (SDA) and A1/P0.05 (SCL) - freed by duplex matrix.
 * I2C pins configured in boards/nice_nano.overlay.
 * Encoder uses P1.01/P1.02 (extra GPIO on back of nice!nano).
 */
&i2c1 {
    trackball: trackball@a {
        compatible = "palette,az1uball";
        reg = <0x0a>;
        label = "TRACKBALL";
        invert-x;
        /* Uncomment to adjust trackball behavior:
         * invert-y;
         * swap-xy;
         */
    };
};
